ction_and_descend():\r\n    for ufo in sprites.all_of_kind(Enemy):\r\n        ufo.vx *= -1\r\n        ufo.y += 4 # bug2 set to 40 so the aliens drop down too far\r\n\r\ndef tick():\r\n    for ufo in sprites.all_of_kind(Enemy):\r\n        if ufo.left < 0 or ufo.right > 160:\r\n            change_direction_and_descend()\r\n            break\r\ngame.on_update(tick)\r\n","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myTiles\"\n    }\n}","tilemap.g.ts":"","images.g.jres":"{\n    \"image1\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABARAAAAAAAAEBEAAAAAAAAQEQAAAAAAEBERAAAAAAAQEREAAAAAABAREQAAAAAAEBERAAAAAAAAEBEAAAAAAAAQEQAAAAAAABARAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"ship\"\n    },\n    \"image3\": {\n        \"data\": \"hwQCAAIAAAAiAAAAIgAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"laser\"\n    },\n    \"image5\": {\n        \"data\": \"hwQHAAkAAAAAAAACAAAAAAAAIAIFAAAAINLdTQAAAAAi0t1NBQAAACDS3U0AAAAAAAAgAgUAAAAAAAACAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"missile\"\n    },\n    \"image4\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAPD//w8AAAAA/zMz/wAAAAA/MzPzDwAAAD8zMzP/AAAAPzMzs/sPAAD/MzO7u/8AAPA/M7u7+wAA/zMzu7v/AAA/EzGz+w8AAD8TMTP/AAAAPzMz8w8AAAD/MzP/AAAAAPD//w8AAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"heart\"\n    },\n    \"image2\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAANAAA